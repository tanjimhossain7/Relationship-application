# Supabase (Project Settings -> API). Without these the app runs in "demo mode"
# and only saves to the current browser.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Optional: Spotify developer app client ID, enables "Connect Spotify" now-playing sharing.
NEXT_PUBLIC_SPOTIFY_CLIENT_ID=
